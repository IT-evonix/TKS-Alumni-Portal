# The Kalyani School Alumni Portal — environment variables
# Copy to .env and fill in values. For Plesk, set these in Node.js > Custom environment variables.

# ----- Required -----
NODE_ENV=production
PORT=5000
BASE_URL=https://your-domain.com

# Database (Supabase Postgres or other)
DATABASE_URL=postgresql://user:password@host:5432/database

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session & auth
SESSION_SECRET=your-strong-random-session-secret
JWT_SECRET=your-strong-random-jwt-secret

# ----- Optional -----
# Token encryption
ENCRYPTION_KEY=your-32-char-hex-key

# Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com

# Email (ZeptoMail) — from-address domain must be verified in ZeptoMail Agent (Sender Identities)
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM_EMAIL=alumni@thekalyanischool.com
ZEPTOMAIL_FROM_NAME=Alumni Portal
EMAIL_LOGO_URL=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Scheduler
ENABLE_CRON_JOBS=true
